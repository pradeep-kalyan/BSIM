// =======================================================
// PRISMA SCHEMA - Business Simulation Platform
// Database: PostgreSQL
// =======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =======================================================
// USER MODEL
// =======================================================
model user {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("user") // user / admin
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  simulations       simulation[]        @relation("user_created_simulations")
  simulation_access simulation_access[] @relation("simulation_access_user")
  companies         company[]
  company_access    company_access[]
  finance_decisions finance[]

  @@map("users")
}

// =======================================================
// SIMULATION MODEL
// =======================================================
model simulation {
  id             String   @id @default(cuid())
  name           String
  description    String?  @db.LongText
  config         String   @db.LongText 
  current_period Int      @default(1)
  status         String   @default("active") // active / paused / completed
  created_by     String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Relations
  creator           user                @relation("user_created_simulations", fields: [created_by], references: [id], onDelete: Cascade)
  companies         company[]
  simulation_access simulation_access[] @relation("simulation_access_sim")

  @@index([created_by])
  @@map("simulations")
}

// =======================================================
// COMPANY MODEL
// =======================================================
model company {
  id                String   @id @default(cuid())
  simulation_id     String
  user_id           String
  name              String
  description       String?
  logo_url          String?
  cash_balance      Float    @default(0)
  current_period    Int      @default(1)
  data              String   @default("{}") // extra JSON info
  total_assets      Float    @default(0)
  total_liabilities Float    @default(0)
  marketing_budget  Float    @default(0)
  credit_rating     String?
  brand_value       Float    @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  simulation simulation @relation(fields: [simulation_id], references: [id], onDelete: Cascade)
  user       user       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  products             product[]
  company_access       company_access[]
  hr_decisions         hr_decision[]
  finance_decisions    finance[]
  rd_decisions         rd[]
  production_decisions production[]
  marketing_decisions  marketing[]
  company_histories    company_history[]

  @@index([simulation_id])
  @@index([user_id])
  @@map("companies")
}

// =======================================================
// COMPANY HISTORY (Snapshot per period)
// =======================================================
model company_history {
  id                String   @id @default(cuid())
  company_id        String
  period            Int
  cash_balance      Float    @default(0)
  data              String   @default("{}")
  total_assets      Float    @default(0)
  total_liabilities Float    @default(0)
  marketing_budget  Float    @default(0)
  credit_rating     String?
  brand_value       Float    @default(0)
  created_at        DateTime @default(now())

  company company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, period])
  @@index([company_id])
  @@map("company_histories")
}

// =======================================================
// SIMULATION ACCESS
// =======================================================
model simulation_access {
  id            String   @id @default(cuid())
  simulation_id String
  user_id       String
  access_level  String   @default("viewer") // viewer / editor / owner
  granted_at    DateTime @default(now())

  simulation simulation @relation("simulation_access_sim", fields: [simulation_id], references: [id], onDelete: Cascade)
  user       user       @relation("simulation_access_user", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([simulation_id, user_id])
  @@index([simulation_id])
  @@index([user_id])
  @@map("simulation_access")
}

// =======================================================
// COMPANY ACCESS
// =======================================================
model company_access {
  id           String   @id @default(cuid())
  company_id   String
  user_id      String
  access_level String   @default("viewer") // viewer / editor / owner
  granted_at   DateTime @default(now())

  company company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user    user    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([company_id, user_id])
  @@index([company_id])
  @@index([user_id])
  @@map("company_access")
}

// =======================================================
// PRODUCT
// =======================================================
model product {
  id                    String   @id @default(cuid())
  company_id            String
  name                  String
  description           String?
  category              String
  quality_rating        Float    @default(0)
  innovation_rating     Float    @default(0)
  sustainability_rating Float    @default(0)
  status                String   @default("development") // development / active / discontinued
  launch_period         Int?
  discontinue_period    Int?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  company      company               @relation(fields: [company_id], references: [id], onDelete: Cascade)
  productions  production[]
  performances product_performance[]

  @@unique([company_id, name])
  @@index([company_id])
  @@map("products")
}

// =======================================================
// FINANCE DECISIONS
// =======================================================
model finance {
  id                String    @id @default(cuid())
  company_id        String
  user_id           String?
  period            Int
  total_revenue     Float     @default(0)
  net_profit        Float     @default(0)
  cash_balance      Float     @default(0)
  operating_costs   Float     @default(0)
  roi               Float     @default(0)
  burn_rate         Float     @default(0)
  finalised         Boolean   @default(false)
  investment_amount Float     @default(0)
  loan_amount       Float     @default(0)
  repay_loan        Float     @default(0)
  dividend_payout   Float     @default(0)
  equity_issue      Float     @default(0)
  notes             String?
  processed         Boolean   @default(false)
  submitted_at      DateTime  @default(now())
  processed_at      DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  company company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user    user?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([company_id, period])
  @@index([company_id])
  @@index([user_id])
  @@map("finance")
}

// =======================================================
// PRODUCTION (Manufacturing Data Only)
// =======================================================
model production {
  id                  String   @id @default(cuid())
  company_id          String
  product_id          String
  period              Int
  units_to_produce    Int
  cost_per_unit       Float    @default(0)
  total_cost          Float    @default(0)
  production_capacity Int      @default(0)
  storage_capacity    Int?     @default(0)
  inventory_value     Float    @default(0)
  defect_rate         Float    @default(0)
  finalised           Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  product product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([company_id, product_id, period])
  @@index([company_id])
  @@index([product_id])
}

// =======================================================
// HR DECISIONS
// =======================================================
model hr_decision {
  id           String   @id @default(cuid())
  company_id   String
  period       Int
  is_submitted Boolean  @default(false)
  submitted_at DateTime @default(now())

  salary_budget         Float @default(0)
  training_budget       Float @default(0)
  total_budget          Float @default(0)
  employee_satisfaction Float @default(0)
  recruitment_cost      Float @default(0)
  firing_cost           Float @default(0)
  total_employee_count  Int?  @default(0)

  company company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  roles   hr_role_decision[]

  @@unique([company_id, period])
  @@index([company_id])
  @@map("hr_decisions")
}

model hr_role_decision {
  id              String @id @default(cuid())
  hr_decision_id  String
  role_name       String
  salary_per_head Float
  head_count      Int

  hr_decision hr_decision @relation(fields: [hr_decision_id], references: [id], onDelete: Cascade)

  @@index([hr_decision_id])
  @@map("hr_role_decisions")
}

// =======================================================
// R&D DECISIONS
// =======================================================
model rd {
  id                String   @id @default(cuid())
  company_id        String
  period            Int
  budget            Int
  pip               Int
  time_to_market    Int
  total_development Int
  patented          Int
  quality_changes   Int
  finalised         Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, period])
  @@index([company_id])
}

// =======================================================
// MARKETING DECISIONS
// =======================================================
model marketing {
  id         String   @id @default(cuid())
  company_id String
  period     Int
  budget     Int
  offline    Int
  online     Int
  finalised  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, period])
  @@index([company_id])
}

// =======================================================
// PRODUCT PERFORMANCE (Sales & Market Data Only)
// =======================================================
model product_performance {
  id                    String   @id @default(cuid())
  product_id            String
  period                Int
  sales_volume          Int      @default(0) // units sold
  selling_price         Float    @default(0) // per unit price for that period
  revenue               Float    @default(0) // sales_volume * selling_price
  profit                Float    @default(0) // revenue - costs
  market_share          Float    @default(0) // percentage
  customer_satisfaction Float    @default(0) // rating 0-100
  costs                 Float    @default(0) // total sales/distribution costs
  data                  String   @default("{}") // extra metrics JSON
  created_at            DateTime @default(now())

  product product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, period])
  @@index([product_id])
  @@map("product_performances")
}
