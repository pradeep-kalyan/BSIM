generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider             = "postgresql"
  url                  = env("DATABASE_URL")
  referentialIntegrity = "prisma"
}

model user {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("user")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  simulations       simulation[]        @relation("UserCreatedSimulations")
  simulation_access simulation_access[] @relation("SimulationAccessUser")
  companies         company[]
  company_access    company_access[]
  decisions         FinanceDecision[]
budgetRequests   BudgetRequest[] 
  @@map("users")
}

model simulation {
  id             String   @id @default(cuid())
  name           String
  description    String?
  config         String   @default("{}")
  current_period Int      @default(0)
  status         String   @default("active")
  created_by     String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  creator user @relation("UserCreatedSimulations", fields: [created_by], references: [id], onDelete: Cascade)

  companies         company[]
  events            event[]
  market_conditions market_condition[]

  simulation_access simulation_access[] @relation("SimulationAccessSim")

  @@map("simulations")
}

model company {
  id                  String               @id @default(cuid())
  simulation_id       String
  user_id             String
  name                String
  description         String?
  logo_url            String?
  cash_balance        Float                @default(0)
  current_period      Int                  @default(1)
  data                String               @default("{}")
  total_assets        Float                @default(0)
  total_liabilities   Float                @default(0)
  credit_rating       String?
  brand_value         Float                @default(0)
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  simulation          simulation           @relation(fields: [simulation_id], references: [id], onDelete: Cascade)
  user                user                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  decisions           decision[]
  performance_results performance_result[]
  products            product[]
  company_access      company_access[]
  financeDecisions    FinanceDecision[]
  budgetRequests   BudgetRequest[] 
  @@map("companies")
}

model simulation_access {
  id            String   @id @default(cuid())
  simulation_id String
  user_id       String
  access_level  String   @default("viewer")
  granted_at    DateTime @default(now())

  simulation simulation @relation("SimulationAccessSim", fields: [simulation_id], references: [id], onDelete: Cascade)
  user       user       @relation("SimulationAccessUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([simulation_id, user_id])
  @@map("simulation_access")
}

model company_access {
  id           String   @id @default(cuid())
  company_id   String
  user_id      String
  access_level String   @default("viewer") // Optional: can be 'viewer', 'editor', etc.
  granted_at   DateTime @default(now())

  company company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user    user    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([company_id, user_id]) // Ensures each user only has one access entry per company
  @@map("company_access")
}

model product {
  id                    String                @id @default(cuid())
  company_id            String
  name                  String
  description           String?
  category              String
  quality_rating        Float                 @default(0)
  innovation_rating     Float                 @default(0)
  sustainability_rating Float                 @default(0)
  production_cost       Float                 @default(0)
  selling_price         Float                 @default(0)
  inventory_level       Int                   @default(0)
  production_capacity   Int                   @default(2000)
  development_cost      Float                 @default(0)
  marketing_budget      Float                 @default(0)
  status                String                @default("development")
  launch_period         Int?
  discontinue_period    Int?
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  product_performances  product_performance[]
  company               company               @relation(fields: [company_id], references: [id])

  @@map("products")
}

model decision {
  id            String    @id @default(cuid())
  company_id    String
  period        Int
  type          String
  decision_data String
  submitted_at  DateTime  @default(now())
  processed     Boolean   @default(false)
  processed_at  DateTime?
  company       company   @relation(fields: [company_id], references: [id])

  @@map("decisions")
}

model market_condition {
  id                        String     @id @default(cuid())
  simulation_id             String
  period                    Int
  data                      String     @default("{}")
  total_market_size         Float
  segment_distribution      String
  economic_indicators       String
  consumer_preferences      String
  technology_trends         String
  sustainability_importance Float
  created_at                DateTime   @default(now())
  simulation                simulation @relation(fields: [simulation_id], references: [id])

  @@unique([simulation_id, period])
  @@map("market_conditions")
}

model performance_result {
  id                    String   @id @default(cuid())
  company_id            String
  period                Int
  data                  String   @default("{}")
  revenue               Float    @default(0)
  costs                 Float    @default(0)
  profit                Float    @default(0)
  market_share          Float    @default(0)
  cash_flow             Float    @default(0)
  roi                   Float    @default(0)
  customer_satisfaction Float    @default(0)
  employee_satisfaction Float    @default(0)
  sustainability_score  Float    @default(0)
  innovation_score      Float    @default(0)
  brand_value_change    Float    @default(0)
  created_at            DateTime @default(now())
  company               company  @relation(fields: [company_id], references: [id])

  @@unique([company_id, period])
  @@map("performance_results")
}

model product_performance {
  id                    String   @id @default(cuid())
  product_id            String
  period                Int
  data                  String   @default("{}")
  sales_volume          Int      @default(0)
  revenue               Float    @default(0)
  costs                 Float    @default(0)
  profit                Float    @default(0)
  market_share          Float    @default(0)
  customer_satisfaction Float    @default(0)
  created_at            DateTime @default(now())
  product               product  @relation(fields: [product_id], references: [id])

  @@unique([product_id, period])
  @@map("product_performances")
}

model event {
  id                 String     @id @default(cuid())
  simulation_id      String
  period             Int
  type               String
  name               String
  description        String?
  impact_area        String
  impact_strength    Float
  affected_companies String
  created_at         DateTime   @default(now())
  simulation         simulation @relation(fields: [simulation_id], references: [id])

  @@map("events")
}

model FinanceDecision {
  id               String   @id @default(cuid())
  companyId        String
  userId           String
  period           Int
  investmentAmount Float    @default(0)
  loanAmount       Float    @default(0)
  repayLoan        Float    @default(0)
  dividendPayout   Float    @default(0)
  equityIssue      Float    @default(0)
  notes            String?
  processed        Boolean  @default(false)
  submittedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company company? @relation(fields: [companyId], references: [id])
  user    user     @relation(fields: [userId], references: [id])

  @@unique([companyId, period])
  @@map("finance_decisions")
}
model BudgetRequest {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  period      Int
  department  String
  amount      Float
  notes       String?
  status      String   @default("pending") // 'pending', 'approved', 'rejected'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company company @relation(fields: [companyId], references: [id])
  user    user    @relation(fields: [userId], references: [id])

  @@unique([companyId, period, department])
  @@map("budget_requests")
}
